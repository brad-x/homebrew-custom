Build the UTM Metal SPICE display only when OpenGL (libepoxy) is enabled.

ui/spice-display-metal.m includes ui/egl-helpers.h, which needs
<epoxy/gl.h>, and every caller of the Metal code is inside OpenGL-only
paths. UTM always builds with OpenGL, so upstream never hits this; a build
without libepoxy fails with "fatal error: 'epoxy/gl.h' file not found".

--- a/meson.build	2026-11-20 09:49:59
+++ b/meson.build	2026-11-20 09:50:17
@@ -2644,7 +2644,7 @@
     ('0' + xen_version[2]).substring(-2)
   config_host_data.set('CONFIG_XEN_CTRL_INTERFACE_VERSION', xen_ctrl_version)
 endif
-config_host_data.set('CONFIG_METAL', metal.found())
+config_host_data.set('CONFIG_METAL', metal.found() and opengl.found())
 config_host_data.set('QEMU_VERSION', '"@0@"'.format(meson.project_version()))
 config_host_data.set('QEMU_VERSION_MAJOR', meson.project_version().split('.')[0])
 config_host_data.set('QEMU_VERSION_MINOR', meson.project_version().split('.')[1])
--- a/ui/meson.build	2026-11-20 09:49:59
+++ b/ui/meson.build	2026-11-20 09:50:17
@@ -146,7 +146,7 @@
   if quartzcore.found()
     spice_core_ss.add(quartzcore)
   endif
-  if metal.found()
+  if metal.found() and opengl.found()
     spice_core_ss.add(metal)
     spice_core_ss.add(files('spice-display-metal.m'))
   endif
